<section class="nw-body{{#if down}} is-down{{/if}}{{#if system.element}} nw-el-edge-{{system.element}}{{/if}}">
  <header class="nw-head">
    <img class="nw-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Change the portrait">
    <div class="nw-head-main">
      <input class="nw-name" type="text" name="name" value="{{actor.name}}" placeholder="Name" {{#unless editable}}disabled{{/unless}}>
      <div class="nw-flags">
        {{#if element}}<span class="nw-el nw-el-{{system.element}}">{{element.label}}</span>{{/if}}
        {{#if style}}<span class="nw-flag">{{style.label}}</span>{{/if}}
        {{#if perk}}<span class="nw-flag">{{perk.label}}</span>{{/if}}
        {{#if awakening}}<span class="nw-flag{{#if awakenedActive}} lit{{/if}}">{{awakening.label}}</span>{{/if}}
        {{#if down}}<span class="nw-flag down">Down</span>{{/if}}
      </div>
      <label class="nw-field">Who they were before tonight
        <input type="text" name="system.before" value="{{system.before}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="nw-field">What they were doing when their element woke
        <input type="text" name="system.woke" value="{{system.woke}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </header>

  <div class="nw-tracks">
    <div class="nw-track">
      <span class="nw-label">Vigour</span>
      <span class="nw-pips">{{#each vigorPips}}<a class="pip{{#if on}} on{{/if}}" data-action="setVigor" data-value="{{value}}" title="{{value}}"></a>{{/each}}</span>
      <span class="nw-count">{{system.vigor.value}} / {{system.vigor.max}}</span>
    </div>
    <div class="nw-track">
      <span class="nw-label">Chi</span>
      <span class="nw-pips chi">{{#each chiPips}}<a class="pip{{#if on}} on{{/if}}" data-action="setChi" data-value="{{value}}" title="{{value}}"></a>{{/each}}</span>
      <span class="nw-count">{{system.chi}} / 5</span>
    </div>
  </div>

  <div class="nw-actions">
    {{#if inFight}}<p class="nw-fight">{{fightLabel}}{{#if ringText}} · Ring: {{ringText}}{{/if}}</p>{{else}}<p class="nw-fight">Not in a fight.</p>{{/if}}
    {{#if canFree}}<button type="button" data-action="freeStrike"><i class="fa-solid fa-bolt"></i> Quick: free Strike</button>{{/if}}
    {{#if canStrike}}<button type="button" data-action="strike"><i class="fa-solid fa-hand-fist"></i> Strike</button>{{/if}}
    {{#if canStrike}}<button type="button" data-action="rally"><i class="fa-solid fa-hand-holding-heart"></i> Rally</button>{{/if}}
    {{#if sealHolder}}<button type="button" data-action="holdSeal"><i class="fa-solid fa-circle-stop"></i> Hold the Seal</button>{{/if}}
    {{#if canAwaken}}<button type="button" data-action="awaken"><i class="fa-solid fa-sun"></i> Awaken (3 Chi)</button>{{/if}}
    <button type="button" data-action="openNight"><i class="fa-solid fa-moon"></i> The Night</button>
  </div>

  <div class="nw-picks">
    <label class="nw-field">Element
      <select name="system.element" {{#unless editable}}disabled{{/unless}}>
        <option value=""></option>
        {{#each elements}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="nw-field">Fighting style
      <select name="system.style" {{#unless editable}}disabled{{/unless}}>
        <option value=""></option>
        {{#each styles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="nw-field">Perk
      <select name="system.perk" {{#unless editable}}disabled{{/unless}}>
        <option value=""></option>
        {{#each perks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="nw-field">Awakening
      <select name="system.awakening" {{#unless editable}}disabled{{/unless}}>
        <option value=""></option>
        {{#each awakenings}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>

  <dl class="nw-text">
    {{#if element}}<dt>Technique: {{element.techniqueLabel}} <span class="hint">(1 Chi, with a Strike)</span></dt><dd>{{element.text}} <span class="hint">Feeds {{feedsLabel}} · shatters {{breaksLabel}} Shells.</span></dd>{{/if}}
    {{#if style}}<dt>{{style.label}}</dt><dd>{{style.text}}</dd>{{/if}}
    {{#if perk}}<dt>{{perk.label}}</dt><dd>{{perk.text}}</dd>{{/if}}
    {{#if awakening}}<dt>Awakening: {{awakening.label}}</dt><dd>{{awakening.text}} <em>{{awakenedText}}</em></dd>{{/if}}
    {{#unless element}}<dd class="hint">Make four picks (Chapter 2). No two fighters in a group share any pick.</dd>{{/unless}}
  </dl>

  <label class="nw-field nw-notes">Notes: what you saw tonight, who you need to find
    <textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
  </label>
</section>
